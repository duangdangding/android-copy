<?xml version="1.0" encoding="utf-8"?>
<!-- 文件发送结果弹窗：状态图标 + 标题 + 汇总信息 + 读秒自动关闭按钮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- 状态图标：成功绿 ✓ / 部分失败橙 !，颜色由代码 backgroundTint 设置 -->
    <TextView
        android:id="@+id/tvFsResultIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_result_circle"
        android:gravity="center"
        android:text="✓"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvFsResultTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="发送完成"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- 失败明细可能有多行，超高时内部滚动 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/tvFsResultMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </ScrollView>

    <Button
        android:id="@+id/btnFsResultOk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="知道了（5）" />
</LinearLayout>
