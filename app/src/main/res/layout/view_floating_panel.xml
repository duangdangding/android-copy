<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- 标题栏：按住可拖动面板；左侧圆点手柄提示可拖，右侧为图标按钮（暂停/管理/收起） -->
    <LinearLayout
        android:id="@+id/panelHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_drag_handle"
            android:drawablePadding="6dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:text="剪贴板记录"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnPanelMonitor"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="暂停监听"
            android:padding="5dp"
            android:src="@drawable/ic_pause" />

        <ImageButton
            android:id="@+id/btnPanelApp"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="打开主界面"
            android:padding="5dp"
            android:src="@drawable/ic_manage" />

        <ImageButton
            android:id="@+id/btnPanelClose"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="收起面板"
            android:padding="5dp"
            android:src="@drawable/ic_collapse" />
    </LinearLayout>

    <EditText
        android:id="@+id/etPanelSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_search_capsule"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="6dp"
        android:hint="搜索剪贴板内容…"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvPanelEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawableTop="@drawable/ic_empty_clipboard"
        android:drawablePadding="10dp"
        android:gravity="center"
        android:padding="24dp"
        android:text="暂无记录"
        android:textColor="@color/text_hint"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/panelRecycler"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_marginTop="6dp"
        android:clipToPadding="false" />

    <!-- 右下角拖拽手柄：拖动调整面板宽高 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/panelResize"
            android:layout_width="36dp"
            android:layout_height="28dp"
            android:layout_gravity="end"
            android:gravity="center"
            android:text="◢"
            android:textColor="@color/text_tertiary"
            android:textSize="16sp" />
    </FrameLayout>
</LinearLayout>
