<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- 标题栏：按住可拖动面板 -->
    <LinearLayout
        android:id="@+id/panelHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="⠿ 剪贴板记录"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPanelMonitor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="6dp"
            android:singleLine="true"
            android:text="暂停"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnPanelApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="6dp"
            android:singleLine="true"
            android:text="管理"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnPanelClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="6dp"
            android:singleLine="true"
            android:text="收起"
            android:textSize="11sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/etPanelSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_item"
        android:hint="搜索剪贴板内容…"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:padding="8dp"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvPanelEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="暂无记录"
        android:textColor="#888888"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/panelRecycler"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_marginTop="6dp"
        android:clipToPadding="false" />

    <!-- 右下角拖拽手柄：拖动调整面板宽高 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/panelResize"
            android:layout_width="36dp"
            android:layout_height="28dp"
            android:layout_gravity="end"
            android:gravity="center"
            android:text="◢"
            android:textColor="#AAAAAA"
            android:textSize="16sp" />
    </FrameLayout>
</LinearLayout>
