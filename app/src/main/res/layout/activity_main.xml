<?xml version="1.0" encoding="utf-8"?>
<!-- 按钮已压缩为 5 行小按钮，顶部控制区完全展开不再滚动；
     搜索框与列表占据下方剩余空间 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/purple_500"
        android:title="@string/app_name"
        android:titleTextColor="@color/white"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textColor="#666666"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvStorage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingBottom="6dp"
                android:textColor="#666666"
                android:textSize="12sp" />

            <!-- 无障碍开启引导已合并到顶部状态栏（点我开启），此按钮已移除 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp">

                <Button
                    android:id="@+id/btnToggleService"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:insetTop="@dimen/main_btn_inset_v"
                    android:insetBottom="@dimen/main_btn_inset_v"
                    android:minHeight="@dimen/main_btn_min_h"
                    android:singleLine="true"
                    android:text="开启监听+悬浮球"
                    android:textSize="@dimen/main_btn_text_size" />

                <Button
                    android:id="@+id/btnAbout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:insetTop="@dimen/main_btn_inset_v"
                    android:insetBottom="@dimen/main_btn_inset_v"
                    android:minHeight="@dimen/main_btn_min_h"
                    android:singleLine="true"
                    android:text="关于"
                    android:textSize="@dimen/main_btn_text_size" />
            </LinearLayout>

            <Button
                android:id="@+id/btnShizuku"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:insetTop="@dimen/main_btn_inset_v"
                android:insetBottom="@dimen/main_btn_inset_v"
                android:minHeight="@dimen/main_btn_min_h"
                android:text="Shizuku 免打扰读取：检测中…"
                android:textSize="@dimen/main_btn_text_size" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp">

                <Button
                    android:id="@+id/btnLanSync"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:insetTop="@dimen/main_btn_inset_v"
                    android:insetBottom="@dimen/main_btn_inset_v"
                    android:minHeight="@dimen/main_btn_min_h"
                    android:singleLine="true"
                    android:text="局域网同步"
                    android:textSize="@dimen/main_btn_text_size" />

                <Button
                    android:id="@+id/btnFileShare"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:insetTop="@dimen/main_btn_inset_v"
                    android:insetBottom="@dimen/main_btn_inset_v"
                    android:minHeight="@dimen/main_btn_min_h"
                    android:singleLine="true"
                    android:text="文件共享"
                    android:textSize="@dimen/main_btn_text_size" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp">

                <Button
                    android:id="@+id/btnDeleteRange"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:insetTop="@dimen/main_btn_inset_v"
                    android:insetBottom="@dimen/main_btn_inset_v"
                    android:minHeight="@dimen/main_btn_min_h"
                    android:singleLine="true"
                    android:text="按时间删除"
                    android:textSize="@dimen/main_btn_text_size" />

                <Button
                    android:id="@+id/btnBackup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:insetTop="@dimen/main_btn_inset_v"
                    android:insetBottom="@dimen/main_btn_inset_v"
                    android:minHeight="@dimen/main_btn_min_h"
                    android:singleLine="true"
                    android:text="备份"
                    android:textSize="@dimen/main_btn_text_size" />

                <Button
                    android:id="@+id/btnImport"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:insetTop="@dimen/main_btn_inset_v"
                    android:insetBottom="@dimen/main_btn_inset_v"
                    android:minHeight="@dimen/main_btn_min_h"
                    android:singleLine="true"
                    android:text="导入"
                    android:textSize="@dimen/main_btn_text_size" />
            </LinearLayout>

            <Button
                android:id="@+id/btnMaxRecords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:insetTop="@dimen/main_btn_inset_v"
                android:insetBottom="@dimen/main_btn_inset_v"
                android:minHeight="@dimen/main_btn_min_h"
                android:text="记录数量上限：无限制"
                android:textSize="@dimen/main_btn_text_size" />
    </LinearLayout>

    <!-- 搜索框固定在列表上方 -->
    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:background="@drawable/bg_item"
        android:hint="搜索剪贴板内容…"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:padding="8dp"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@+id/header" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="暂无剪贴板记录\n复制任意内容后会出现在这里"
        android:textColor="#888888"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etSearch" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="8dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etSearch" />
</androidx.constraintlayout.widget.ConstraintLayout>
