<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ClipDitto" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="android:statusBarColor">@color/purple_700</item>
    </style>

    <!-- 主页 Toolbar：紫色底上白色菜单图标；弹出菜单用 PopupMenuTheme，跟随页面浅色/深色 -->
    <style name="ToolbarTheme" parent="ThemeOverlay.Material3.Dark">
        <item name="android:textColorSecondary">@color/white</item>
        <item name="popupTheme">@style/PopupMenuTheme</item>
    </style>

    <!-- Toolbar 溢出菜单弹层：浅色（夜间模式在 values-night 里换成深色） -->
    <style name="PopupMenuTheme" parent="ThemeOverlay.Material3.Light" />

    <!-- 设置页：分节标题 -->
    <style name="SettingsSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">@color/purple_500</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 设置页：分节说明文字 -->
    <style name="SettingsSectionHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">@color/text_hint</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- 设置页：整宽条目按钮 -->
    <style name="SettingsItemButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">16dp</item>
        <item name="android:layout_marginVertical">2dp</item>
    </style>
</resources>
